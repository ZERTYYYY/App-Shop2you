<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Mon Véhicule' }) %>
<body>
<div class="app-shell">
  <% const page = 'vehicle'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Mon véhicule</h1>
        <p class="text-muted text-sm mt-1">Informations sur votre véhicule</p>
      </div>
      <button class="btn-accent"><%- icon('pencil','w-4 h-4') %> Modifier</button>
    </div>

    <div class="card bg-ink text-cream mb-6 flex items-center gap-5">
      <div class="stat-icon bg-white/10 text-cream w-16 h-16 shrink-0"><%- icon('car','w-8 h-8') %></div>
      <div>
        <h2 class="text-cream"><%= user.vehicle.brand %> <%= user.vehicle.model %></h2>
        <p class="text-cream/50"><%= user.vehicle.type %> · <%= user.vehicle.color %></p>
        <span class="badge-accent mt-2"><%= user.vehicle.plate %></span>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card">
        <h3 class="mb-4">Informations du véhicule</h3>
        <div class="divide-y divide-border text-sm">
          <div class="flex justify-between py-2.5"><span class="text-muted">Type</span><span class="font-medium"><%= user.vehicle.type %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Marque</span><span class="font-medium"><%= user.vehicle.brand %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Modèle</span><span class="font-medium"><%= user.vehicle.model %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Couleur</span><span class="font-medium"><%= user.vehicle.color %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Plaque</span><span class="font-semibold"><%= user.vehicle.plate %></span></div>
        </div>
      </div>

      <div class="card">
        <h3 class="mb-4">Documents</h3>
        <% const docs = [
          {name: 'Permis de conduire', status: 'vérifié'},
          {name: 'Carte grise', status: 'vérifié'},
          {name: 'Assurance', status: 'en attente'},
          {name: 'Contrôle technique', status: 'vérifié'},
        ]; %>
        <div class="divide-y divide-border text-sm">
        <% docs.forEach(d => { %>
        <div class="flex justify-between items-center py-2.5">
          <span class="text-muted"><%= d.name %></span>
          <% if(d.status === 'vérifié') { %>
            <span class="badge-success"><%- icon('check','w-3.5 h-3.5') %> Vérifié</span>
          <% } else { %>
            <span class="badge-warning"><%- icon('clock','w-3.5 h-3.5') %> En attente</span>
          <% } %>
        </div>
        <% }) %>
        </div>
        <button class="btn-outline btn-full mt-4"><%- icon('upload','w-4 h-4') %> Ajouter un document</button>
      </div>
    </div>
  </main>
</div>
</body>
</html>
