<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop2You — Mon Véhicule</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
<div class="app-shell">
  <% const page = 'vehicle'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="topbar">
      <div class="topbar-title"><h1>Mon Véhicule 🚗</h1><p>Informations sur votre véhicule</p></div>
      <button class="btn btn-gold">✏️ Modifier</button>
    </div>

    <div class="vehicle-card">
      <div class="vehicle-icon">🏍️</div>
      <div>
        <h2 style="color:var(--white)"><%= user.vehicle.brand %> <%= user.vehicle.model %></h2>
        <p style="color:var(--gray)"><%= user.vehicle.type %> · <%= user.vehicle.color %></p>
        <span class="badge badge-gold" style="margin-top:8px"><%= user.vehicle.plate %></span>
      </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:24px;">
      <div class="card">
        <h3 style="margin-bottom:16px">Informations du véhicule</h3>
        <div class="profile-row"><span class="plabel">Type</span><span class="pval"><%= user.vehicle.type %></span></div>
        <div class="profile-row"><span class="plabel">Marque</span><span class="pval"><%= user.vehicle.brand %></span></div>
        <div class="profile-row"><span class="plabel">Modèle</span><span class="pval"><%= user.vehicle.model %></span></div>
        <div class="profile-row"><span class="plabel">Couleur</span><span class="pval"><%= user.vehicle.color %></span></div>
        <div class="profile-row"><span class="plabel">Plaque</span><span class="pval"><strong><%= user.vehicle.plate %></strong></span></div>
      </div>

      <div class="card">
        <h3 style="margin-bottom:16px">Documents</h3>
        <% const docs = [
          {name: 'Permis de conduire', status: 'vérifié'},
          {name: 'Carte grise', status: 'vérifié'},
          {name: 'Assurance', status: 'en attente'},
          {name: 'Contrôle technique', status: 'vérifié'},
        ]; %>
        <% docs.forEach(d => { %>
        <div class="profile-row">
          <span class="plabel"><%= d.name %></span>
          <% if(d.status === 'vérifié') { %>
            <span class="badge badge-green">✅ Vérifié</span>
          <% } else { %>
            <span class="badge badge-gold">⏳ En attente</span>
          <% } %>
        </div>
        <% }) %>
        <button class="btn btn-outline btn-full" style="margin-top:16px">📄 Ajouter un document</button>
      </div>
    </div>
  </main>
</div>
</body>
</html>
