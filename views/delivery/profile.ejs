<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Mon Profil' }) %>
<body>
<div class="app-shell">
  <% const page = 'profile'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <h1>Mon profil</h1>
      <button class="btn-accent"><%- icon('pencil','w-4 h-4') %> Modifier</button>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div class="card">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-16 h-16 rounded-full bg-accent flex items-center justify-center font-serif text-2xl text-white shrink-0"><%= user.name.charAt(0) %></div>
          <div>
            <h2 class="text-xl"><%= user.name %></h2>
            <p class="text-sm text-muted"><%= user.email %></p>
            <span class="badge-accent mt-1.5">Livreur</span>
          </div>
        </div>
        <div class="grid grid-cols-3 gap-3 mb-5 text-center">
          <div class="bg-white/30 border border-white/40 rounded-xl p-3">
            <div class="text-lg font-semibold"><%= user.stats.trips %></div>
            <div class="text-xs text-muted">Courses</div>
          </div>
          <div class="bg-white/30 border border-white/40 rounded-xl p-3">
            <div class="text-lg font-semibold"><%= user.stats.rating %></div>
            <div class="text-xs text-muted">Note</div>
          </div>
          <div class="bg-white/30 border border-white/40 rounded-xl p-3">
            <div class="text-lg font-semibold"><%= user.stats.time %></div>
            <div class="text-xs text-muted">Moy.</div>
          </div>
        </div>
        <div class="divide-y divide-border text-sm">
          <div class="flex justify-between py-2.5"><span class="text-muted">Nom</span><span class="font-medium"><%= user.name %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Email</span><span class="font-medium"><%= user.email %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Téléphone</span><span class="font-medium"><%= user.phone %></span></div>
          <div class="flex justify-between py-2.5"><span class="text-muted">Ville</span><span class="font-medium"><%= user.city %></span></div>
        </div>
      </div>
      <div class="space-y-6">
        <div class="card">
          <h3 class="mb-2">Vérification d'identité</h3>
          <p class="text-sm mb-4">Téléchargez vos documents pour valider votre compte</p>
          <div class="space-y-1">
          <% ['Passeport','Permis d\'étude','Permis de travail'].forEach((d,i) => { %>
          <label class="flex items-center gap-2.5 py-2 cursor-pointer">
            <input type="radio" name="idtype" <%= i===0?'checked':'' %> class="accent-accent">
            <span class="text-sm"><%= d %></span>
          </label>
          <% }) %>
          </div>
          <div class="grid grid-cols-2 gap-3 mt-4">
            <div class="border-2 border-dashed border-border rounded-xl p-6 text-center cursor-pointer hover:border-accent transition-colors">
              <div class="text-muted mb-2"><%- icon('file','w-6 h-6 mx-auto') %></div>
              <div class="text-xs text-muted">Côté A</div>
            </div>
            <div class="border-2 border-dashed border-border rounded-xl p-6 text-center cursor-pointer hover:border-accent transition-colors">
              <div class="text-muted mb-2"><%- icon('upload','w-6 h-6 mx-auto') %></div>
              <div class="text-xs text-muted">Côté B</div>
            </div>
          </div>
        </div>
        <div class="card">
          <h3 class="mb-3">Accès au véhicule</h3>
          <div class="flex gap-6">
            <label class="flex items-center gap-2 cursor-pointer text-sm">
              <input type="radio" name="vehicle" checked class="accent-accent"> Oui
            </label>
            <label class="flex items-center gap-2 cursor-pointer text-sm">
              <input type="radio" name="vehicle" class="accent-accent"> Non
            </label>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
</body>
</html>
