<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Livreur' }) %>
<body>
<div class="app-shell">
  <% const page = 'dashboard'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Tableau de bord</h1>
        <p class="text-muted text-sm mt-1">Vos missions du jour</p>
      </div>
      <div class="flex items-center gap-2 bg-success-light px-4 py-2 rounded-full">
        <span class="w-2 h-2 rounded-full bg-success"></span>
        <span class="text-sm font-medium text-success">Disponible</span>
      </div>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-accent-light text-accent-dark"><%- icon('car','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.stats.trips %></div><div class="text-xs text-muted">Courses totales</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-success-light text-success"><%- icon('star','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.stats.rating %></div><div class="text-xs text-muted">Note moyenne</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-warning-light text-warning"><%- icon('clock','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.stats.time %></div><div class="text-xs text-muted">Temps moyen</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-danger-light text-danger"><%- icon('list','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.jobs.length %></div><div class="text-xs text-muted">Missions</div></div>
      </div>
    </div>

    <h2 class="mb-4">Missions en cours</h2>
    <div class="space-y-3 mb-8">
      <% user.jobs.forEach(job => { %>
      <div class="card !p-4 flex items-center gap-4">
        <div class="stat-icon bg-white/30 border border-white/40 text-ink shrink-0"><%- icon('box','w-5 h-5') %></div>
        <div class="flex-1 min-w-0">
          <div class="font-medium text-sm"><%= job.client %></div>
          <div class="text-sm text-muted flex items-center gap-1 mt-0.5"><%- icon('pin','w-3.5 h-3.5') %> <%= job.address %></div>
          <div class="mt-1.5 flex items-center gap-2">
            <% if(job.status === 'en cours') { %>
              <span class="badge-warning">En cours</span>
            <% } else { %>
              <span class="badge-accent">En attente</span>
            <% } %>
            <span class="text-xs text-muted"><%= job.time %></span>
          </div>
        </div>
        <div class="flex flex-col items-end gap-2 shrink-0">
          <span class="font-serif text-accent-dark"><%= job.amount.toFixed(2) %>€</span>
          <% if(job.status === 'en attente') { %>
          <button class="btn-accent btn-sm" onclick="acceptJob(this)">Accepter</button>
          <% } else { %>
          <button class="btn-primary btn-sm" onclick="finishJob(this)">Livré</button>
          <% } %>
        </div>
      </div>
      <% }) %>
    </div>

    <!-- Earnings chart area -->
    <div class="card">
      <h3 class="mb-1">Gains de la semaine</h3>
      <p class="text-sm mb-6">Votre activité des 7 derniers jours</p>
      <div class="flex items-end gap-2.5 h-32">
        <% const days = ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim']; %>
        <% const vals = [45, 72, 38, 89, 60, 95, 52]; %>
        <% const max = Math.max(...vals); %>
        <% days.forEach((d,i) => { %>
        <div class="flex-1 flex flex-col items-center gap-1.5">
          <span class="text-xs text-muted font-medium"><%= vals[i] %>€</span>
          <div class="w-full rounded-t-md bg-accent" style="height:<%= Math.round((vals[i]/max)*100) %>px"></div>
          <span class="text-xs text-muted"><%= d %></span>
        </div>
        <% }) %>
      </div>
      <div class="mt-5 pt-5 border-t border-border flex justify-between">
        <div><span class="text-xs text-muted">Total semaine</span><div class="text-xl font-semibold text-accent-dark">451€</div></div>
        <div class="text-right"><span class="text-xs text-muted">Moyenne/jour</span><div class="text-xl font-semibold">64.4€</div></div>
      </div>
    </div>
  </main>
</div>
<script>
function acceptJob(btn) {
  btn.textContent = 'Accepté';
  btn.className = 'btn-primary btn-sm';
  btn.onclick = function() { finishJob(this); };
  const badge = btn.parentElement.previousElementSibling.querySelector('.badge-accent, .badge-warning');
  if (badge) badge.className = 'badge-warning';
}
function finishJob(btn) {
  const card = btn.closest('.card');
  card.style.opacity = '0.5';
  btn.textContent = 'Livré';
  btn.disabled = true;
}
</script>
</body>
</html>
