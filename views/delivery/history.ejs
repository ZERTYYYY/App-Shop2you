<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop2You — Historique</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
<div class="app-shell">
  <% const page = 'history'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="topbar">
      <div class="topbar-title"><h1>Historique 📋</h1><p>Toutes vos livraisons passées</p></div>
    </div>
    <div class="card">
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>N°</th><th>Client</th><th>Date</th><th>Montant</th><th>Statut</th></tr>
          </thead>
          <tbody>
            <% user.history.forEach(h => { %>
            <tr>
              <td><strong><%= h.id %></strong></td>
              <td><%= h.client %></td>
              <td><%= h.date %></td>
              <td><strong><%= h.amount.toFixed(2) %>€</strong></td>
              <td>
                <% if(h.status === 'livré') { %>
                  <span class="badge badge-green">✅ Livré</span>
                <% } else { %>
                  <span class="badge badge-red">❌ Annulé</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
