<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Historique' }) %>
<body>
<div class="app-shell">
  <% const page = 'history'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="mb-8">
      <h1>Historique</h1>
      <p class="text-muted text-sm mt-1">Toutes vos livraisons passées</p>
    </div>
    <div class="card !p-0 overflow-hidden">
      <div class="table-wrap">
        <table class="table-base">
          <thead>
            <tr><th class="th-cell">N°</th><th class="th-cell">Client</th><th class="th-cell">Date</th><th class="th-cell">Montant</th><th class="th-cell">Statut</th></tr>
          </thead>
          <tbody>
            <% user.history.forEach(h => { %>
            <tr>
              <td class="td-cell font-medium"><%= h.id %></td>
              <td class="td-cell"><%= h.client %></td>
              <td class="td-cell text-muted"><%= h.date %></td>
              <td class="td-cell font-medium"><%= h.amount.toFixed(2) %>€</td>
              <td class="td-cell">
                <% if(h.status === 'livré') { %>
                  <span class="badge-success"><%- icon('check','w-3.5 h-3.5') %> Livré</span>
                <% } else { %>
                  <span class="badge-danger"><%- icon('cross','w-3.5 h-3.5') %> Annulé</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
