<button class="menu-toggle" onclick="toggleSidebar()" aria-label="Ouvrir le menu">
  <%- icon('menu', 'w-5 h-5') %>
</button>

<div class="sidebar" id="sidebar">
  <div class="flex items-center gap-2.5 px-6 pt-7 pb-6">
    <div class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-white font-serif font-semibold text-sm">S2</div>
    <span class="font-serif text-lg font-semibold tracking-tight">Shop2You</span>
  </div>

  <div class="flex items-center gap-3 mx-4 mb-6 p-3 rounded-xl bg-white/[0.05]">
    <div class="w-10 h-10 rounded-full bg-accent/90 flex items-center justify-center font-serif font-semibold text-white shrink-0">
      <%= user.name.charAt(0).toUpperCase() %>
    </div>
    <div class="min-w-0">
      <div class="text-sm font-medium text-cream truncate"><%= user.name %></div>
      <div class="text-xs text-cream/50">
        <% if(user.role==='user') { %>Client
        <% } else if(user.role==='delivery') { %>Livreur
        <% } else { %>Vendeur<% } %>
      </div>
    </div>
  </div>

  <nav class="flex-1 px-4 space-y-1 overflow-y-auto">
    <% if(user.role === 'user') { %>
      <a href="/user/dashboard" class="<%= page==='dashboard'?'nav-link-active':'nav-link' %>"><%- icon('home') %> Accueil</a>
      <a href="/user/orders" class="<%= page==='orders'?'nav-link-active':'nav-link' %>"><%- icon('box') %> Mes commandes</a>
      <a href="/user/checkout" class="<%= page==='checkout'?'nav-link-active':'nav-link' %>"><%- icon('cart') %> Panier &amp; Paiement</a>
      <a href="/user/profile" class="<%= page==='profile'?'nav-link-active':'nav-link' %>"><%- icon('user') %> Mon profil</a>
    <% } else if(user.role === 'delivery') { %>
      <a href="/delivery/dashboard" class="<%= page==='dashboard'?'nav-link-active':'nav-link' %>"><%- icon('home') %> Tableau de bord</a>
      <a href="/delivery/history" class="<%= page==='history'?'nav-link-active':'nav-link' %>"><%- icon('list') %> Historique</a>
      <a href="/delivery/vehicle" class="<%= page==='vehicle'?'nav-link-active':'nav-link' %>"><%- icon('car') %> Mon véhicule</a>
      <a href="/delivery/profile" class="<%= page==='profile'?'nav-link-active':'nav-link' %>"><%- icon('user') %> Mon profil</a>
    <% } else { %>
      <a href="/provider/dashboard" class="<%= page==='dashboard'?'nav-link-active':'nav-link' %>"><%- icon('home') %> Tableau de bord</a>
      <a href="/provider/invoices" class="<%= page==='invoices'?'nav-link-active':'nav-link' %>"><%- icon('file') %> Factures</a>
      <a href="/provider/profile" class="<%= page==='profile'?'nav-link-active':'nav-link' %>"><%- icon('user') %> Mon profil</a>
    <% } %>
    <div class="!mt-4 pt-4 border-t border-white/[0.08] space-y-1">
      <a href="/settings" class="<%= page==='settings'?'nav-link-active':'nav-link' %>"><%- icon('gear') %> Paramètres</a>
      <a href="/privacy" class="<%= page==='privacy'?'nav-link-active':'nav-link' %>"><%- icon('shield') %> Confidentialité</a>
    </div>
  </nav>

  <div class="p-4 border-t border-white/[0.08]">
    <a href="/logout" class="nav-link text-danger hover:text-danger hover:bg-danger/10"><%- icon('logout') %> Déconnexion</a>
  </div>
</div>

<div id="sidebar-overlay" class="sidebar-overlay" onclick="toggleSidebar()"></div>

<script>
function toggleSidebar() {
  document.getElementById('sidebar').classList.toggle('open');
  document.getElementById('sidebar-overlay').classList.toggle('open');
}
</script>
