<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: 'Confidentialité' }) %>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', {user, page: 'privacy'}) %>
  <main class="main-content">
    <div class="mb-8">
      <h1>Confidentialité</h1>
      <p class="text-muted text-sm mt-1">Gérez vos données personnelles</p>
    </div>

    <div class="card mb-6">
      <h3 class="mb-3">Vos données</h3>
      <p class="text-sm mb-4">Shop2You est une démo : vos informations (profil, commandes, panier) sont conservées uniquement le temps de la session et ne sont partagées avec aucun tiers.</p>
      <div class="divide-y divide-border">
        <label class="flex justify-between items-center py-3 cursor-pointer">
          <span class="text-sm">Partager mon activité pour améliorer les recommandations</span>
          <input type="checkbox" checked class="w-4 h-4 accent-accent">
        </label>
        <label class="flex justify-between items-center py-3 cursor-pointer">
          <span class="text-sm">Autoriser la localisation pour les livraisons</span>
          <input type="checkbox" checked class="w-4 h-4 accent-accent">
        </label>
      </div>
    </div>

    <div class="card">
      <h3 class="mb-4">Compte</h3>
      <div class="divide-y divide-border">
        <div class="flex justify-between items-center py-3">
          <span class="text-sm">Télécharger mes données</span>
          <button class="btn-outline btn-sm" onclick="alert('Export à venir !')"><%- icon('download','w-3.5 h-3.5') %> Exporter</button>
        </div>
        <div class="flex justify-between items-center py-3">
          <span class="text-sm">Supprimer mon compte</span>
          <button class="btn-danger-outline btn-sm" onclick="alert('Suppression à venir !')"><%- icon('trash','w-3.5 h-3.5') %> Supprimer</button>
        </div>
      </div>
    </div>
  </main>
</div>
</body>
</html>
