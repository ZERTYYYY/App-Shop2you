<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Mes Commandes' }) %>
<body>
<div class="app-shell">
  <% const page = 'orders'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Mes commandes</h1>
        <p class="text-muted text-sm mt-1">Suivi de toutes vos commandes</p>
      </div>
      <a href="/user/dashboard" class="btn-accent"><%- icon('plus', 'w-4 h-4') %> Nouvelle commande</a>
    </div>

    <div class="card !p-0 overflow-hidden">
      <% if(!user.orders || user.orders.length === 0) { %>
      <div class="empty-state">
        <div class="text-muted mb-3"><%- icon('box', 'w-8 h-8 mx-auto') %></div>
        <p>Aucune commande pour l'instant.<br>Commencez à faire du shopping !</p>
        <a href="/user/dashboard" class="btn-accent mt-4">Voir la boutique</a>
      </div>
      <% } else { %>
      <div class="table-wrap">
        <table class="table-base">
          <thead>
            <tr>
              <th class="th-cell">N° Commande</th>
              <th class="th-cell">Date</th>
              <th class="th-cell">Articles</th>
              <th class="th-cell">Total</th>
              <th class="th-cell">Statut</th>
            </tr>
          </thead>
          <tbody>
            <% user.orders.forEach(order => { %>
            <tr>
              <td class="td-cell font-medium"><%= order.id %></td>
              <td class="td-cell text-muted"><%= order.date %></td>
              <td class="td-cell text-muted text-sm"><%= order.items.join(', ') %></td>
              <td class="td-cell font-medium"><%= order.total.toFixed(2) %>€</td>
              <td class="td-cell">
                <% if(order.status === 'delivered') { %>
                  <span class="badge-success"><%- icon('check','w-3.5 h-3.5') %> Livré</span>
                <% } else if(order.status === 'cancelled') { %>
                  <span class="badge-danger"><%- icon('cross','w-3.5 h-3.5') %> Annulé</span>
                <% } else { %>
                  <span class="badge-warning"><%- icon('clock','w-3.5 h-3.5') %> En cours</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
