<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Boutiques' }) %>
<body>
<div class="app-shell">
  <% const page = 'dashboard'; %>
  <%- include('../partials/sidebar', {user, page}) %>

  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Boutiques</h1>
        <p class="text-muted text-sm mt-1">Tout ce dont vous avez besoin, livré chez vous</p>
      </div>
      <button class="btn-outline" onclick="openCart()">
        <%- icon('cart', 'w-4 h-4') %> Panier
        <span id="cart-count" class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-accent text-white text-xs font-semibold"><%= cart.reduce((s,i)=>s+i.qty,0) %></span>
      </button>
    </div>

    <!-- Search & Category tabs -->
    <div class="card !p-4 mb-8">
      <div class="flex gap-3 items-center flex-wrap">
        <div class="relative flex-1 min-w-[200px]">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted"><%- icon('search', 'w-4 h-4') %></span>
          <input class="input !pl-10" id="searchInput" type="text" placeholder="Rechercher un magasin..." oninput="filterStores()">
        </div>
        <div class="flex gap-2 flex-wrap" id="categoryBtns">
          <% categories.forEach((c, i) => { %>
          <button class="<%= i===0 ? 'btn-primary' : 'btn-outline' %> btn-sm" data-cat="<%= c.id %>" onclick="filterCat('<%= c.id %>')"><%= c.label %></button>
          <% }) %>
        </div>
      </div>
    </div>

    <!-- Stores -->
    <div class="flex items-baseline justify-between mb-4">
      <h2>Magasins à proximité</h2>
      <span id="store-count" class="text-sm text-muted"></span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-5" id="storesGrid">
      <% stores.forEach(s => { %>
      <a href="/user/store/<%= s.id %>" class="store-card card !p-0 overflow-hidden flex flex-col hover:-translate-y-0.5 hover:shadow-lg transition-all" data-name="<%= s.name.toLowerCase() %>" data-cat="<%= s.category %>">
        <div class="h-24 flex items-center justify-center" style="background:<%= s.color %>1A">
          <div class="w-14 h-14 rounded-2xl flex items-center justify-center text-white font-serif text-lg font-semibold shadow-soft" style="background:<%= s.color %>"><%= s.initials %></div>
        </div>
        <div class="p-4">
          <div class="font-medium text-sm mb-1 truncate"><%= s.name %></div>
          <div class="text-xs text-muted flex items-center gap-1.5">
            <span class="flex items-center gap-0.5">★ <%= s.rating %></span>
            <span>·</span>
            <span><%= s.time %></span>
          </div>
        </div>
      </a>
      <% }) %>
    </div>
  </main>
</div>

<%- include('../partials/cart-panel', { cart }) %>

<script>
let currentCat = 'tout';

function filterStores() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cards = document.querySelectorAll('.store-card');
  let visible = 0;
  cards.forEach(c => {
    const matchName = c.dataset.name.includes(q);
    const matchCat = currentCat === 'tout' || c.dataset.cat === currentCat;
    if (matchName && matchCat) { c.style.display = ''; visible++; }
    else c.style.display = 'none';
  });
  document.getElementById('store-count').textContent = visible + ' magasin(s)';
}

function filterCat(cat) {
  currentCat = cat;
  document.querySelectorAll('#categoryBtns button').forEach(b => {
    b.className = (b.dataset.cat === cat ? 'btn-primary' : 'btn-outline') + ' btn-sm';
  });
  filterStores();
}

document.addEventListener('DOMContentLoaded', () => filterStores());
</script>
</body>
</html>
