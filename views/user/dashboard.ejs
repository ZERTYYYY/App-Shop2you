<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Boutique' }) %>
<body>
<div class="app-shell">
  <% const page = 'dashboard'; %>
  <%- include('../partials/sidebar', {user, page}) %>

  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Boutique</h1>
        <p class="text-muted text-sm mt-1">Découvrez nos produits sélectionnés</p>
      </div>
      <button class="btn-outline" onclick="openCart()">
        <%- icon('cart', 'w-4 h-4') %> Panier
        <span id="cart-count" class="inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 rounded-full bg-accent text-white text-xs font-semibold"><%= cart.length %></span>
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="card !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-accent-light text-accent-dark"><%- icon('box', 'w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.orders ? user.orders.length : 0 %></div><div class="text-xs text-muted">Commandes</div></div>
      </div>
      <div class="card !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-success-light text-success"><%- icon('check', 'w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.orders ? user.orders.filter(o=>o.status==='delivered').length : 0 %></div><div class="text-xs text-muted">Livrées</div></div>
      </div>
      <div class="card !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-warning-light text-warning"><%- icon('card', 'w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.cards ? user.cards.length : 0 %></div><div class="text-xs text-muted">Carte(s)</div></div>
      </div>
      <div class="card !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-danger-light text-danger"><%- icon('pin', 'w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.addresses ? user.addresses.length : 0 %></div><div class="text-xs text-muted">Adresse(s)</div></div>
      </div>
    </div>

    <!-- Search & Filter -->
    <div class="card !p-4 mb-8">
      <div class="flex gap-3 items-center flex-wrap">
        <div class="relative flex-1 min-w-[200px]">
          <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted"><%- icon('search', 'w-4 h-4') %></span>
          <input class="input !pl-10" id="searchInput" type="text" placeholder="Rechercher un produit..." oninput="filterProducts()">
        </div>
        <div class="flex gap-2 flex-wrap" id="categoryBtns">
          <button class="btn-primary btn-sm" onclick="filterCat('Tous')">Tous</button>
          <button class="btn-outline btn-sm" onclick="filterCat('Chaussures')">Chaussures</button>
          <button class="btn-outline btn-sm" onclick="filterCat('Vêtements')">Vêtements</button>
          <button class="btn-outline btn-sm" onclick="filterCat('Accessoires')">Accessoires</button>
          <button class="btn-outline btn-sm" onclick="filterCat('Pantalons')">Pantalons</button>
        </div>
      </div>
    </div>

    <!-- Products -->
    <div class="flex items-baseline justify-between mb-4">
      <h2>Produits disponibles</h2>
      <span id="product-count" class="text-sm text-muted"></span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="productsGrid">
      <% products.forEach(p => { %>
      <div class="product-card card !p-0 overflow-hidden flex flex-col" data-name="<%= p.name.toLowerCase() %>" data-cat="<%= p.category %>">
        <div class="h-36 flex items-center justify-center text-6xl bg-cream"><%= p.image %></div>
        <div class="p-5 flex flex-col flex-1">
          <div class="font-medium text-sm mb-1"><%= p.name %></div>
          <div class="text-xs text-muted mb-3">★ <%= p.rating %> (<%= p.reviews %> avis) · <%= p.provider %></div>
          <div class="flex items-center justify-between mt-auto pt-2">
            <div class="font-serif text-lg text-accent-dark"><%= p.price.toFixed(2) %>€</div>
          </div>
          <button class="btn-primary btn-full btn-sm mt-3" onclick="addToCart(<%= p.id %>, this)"><%- icon('plus', 'w-3.5 h-3.5') %> Ajouter au panier</button>
        </div>
      </div>
      <% }) %>
    </div>
  </main>
</div>

<!-- Cart Panel -->
<div class="sidebar-overlay" id="cartOverlay" onclick="closeCart()" style="z-index:200"></div>
<div class="fixed top-0 right-0 bottom-0 z-[201] w-full sm:w-96 bg-paper translate-x-full transition-transform duration-300 flex flex-col p-6" id="cartPanel">
  <div class="flex items-center justify-between mb-6">
    <h2>Mon panier</h2>
    <button onclick="closeCart()" class="text-muted hover:text-ink"><%- icon('close', 'w-5 h-5') %></button>
  </div>
  <div class="flex-1 overflow-y-auto" id="cartItems">
    <% if(cart.length === 0) { %>
    <div class="empty-state">
      <div class="text-muted mb-2"><%- icon('cart', 'w-8 h-8 mx-auto') %></div>
      <p>Votre panier est vide</p>
    </div>
    <% } else { %>
    <% cart.forEach(item => { %>
    <div class="flex items-center gap-3.5 py-3.5 border-b border-border">
      <div class="w-12 h-12 rounded-xl bg-cream flex items-center justify-center text-2xl shrink-0"><%= item.image %></div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium truncate"><%= item.name %></div>
        <div class="text-sm text-accent-dark font-medium"><%= item.price.toFixed(2) %>€ × <%= item.qty %></div>
      </div>
      <button class="text-muted hover:text-danger" onclick="removeFromCart(<%= item.id %>)"><%- icon('trash', 'w-4 h-4') %></button>
    </div>
    <% }) %>
    <% } %>
  </div>
  <div class="pt-5">
    <div class="flex items-center justify-between font-semibold mb-4">
      <span>Total</span>
      <span id="cartTotal"><%= cart.reduce((s,i) => s+i.price*i.qty, 0).toFixed(2) %>€</span>
    </div>
    <a href="/user/checkout" class="btn-accent btn-full btn-lg">Commander</a>
  </div>
</div>

<script>
let currentCat = 'Tous';

function filterProducts() {
  const q = document.getElementById('searchInput').value.toLowerCase();
  const cards = document.querySelectorAll('.product-card');
  let visible = 0;
  cards.forEach(c => {
    const matchName = c.dataset.name.includes(q);
    const matchCat = currentCat === 'Tous' || c.dataset.cat === currentCat;
    if (matchName && matchCat) { c.style.display = ''; visible++; }
    else c.style.display = 'none';
  });
  document.getElementById('product-count').textContent = visible + ' produit(s)';
}

function filterCat(cat) {
  currentCat = cat;
  document.querySelectorAll('#categoryBtns button').forEach(b => {
    const match = b.textContent.trim() === cat;
    b.className = match ? 'btn-primary btn-sm' : 'btn-outline btn-sm';
  });
  filterProducts();
}

function renderCart(cart) {
  const itemsEl = document.getElementById('cartItems');
  const countEl = document.getElementById('cart-count');
  const totalEl = document.getElementById('cartTotal');
  const count = cart.reduce((s, i) => s + i.qty, 0);
  const total = cart.reduce((s, i) => s + i.price * i.qty, 0);

  countEl.textContent = count;
  totalEl.textContent = total.toFixed(2) + '€';

  if (cart.length === 0) {
    itemsEl.innerHTML = '<div class="empty-state"><p class="text-muted">Votre panier est vide</p></div>';
    return;
  }
  itemsEl.innerHTML = cart.map(item => `
    <div class="flex items-center gap-3.5 py-3.5 border-b border-border">
      <div class="w-12 h-12 rounded-xl bg-cream flex items-center justify-center text-2xl shrink-0">${item.image}</div>
      <div class="flex-1 min-w-0">
        <div class="text-sm font-medium truncate">${item.name}</div>
        <div class="text-sm text-accent-dark font-medium">${item.price.toFixed(2)}€ × ${item.qty}</div>
      </div>
      <button class="text-muted hover:text-danger" onclick="removeFromCart(${item.id})"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 7h14"/><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/><path d="M7 7l1 12a2 2 0 0 0 2 2h4a2 2 0 0 0 2-2l1-12"/></svg></button>
    </div>
  `).join('');
}

function addToCart(id, btn) {
  const original = btn.innerHTML;
  btn.textContent = 'Ajout...';
  btn.disabled = true;
  fetch('/user/cart/add', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ productId: id })
  }).then(r => r.json()).then(d => {
    if (d.success) {
      btn.textContent = 'Ajouté ✓';
      renderCart(d.cart);
      setTimeout(() => { btn.innerHTML = original; btn.disabled = false; }, 1200);
    }
  });
}

function removeFromCart(id) {
  fetch('/user/cart/remove', {
    method: 'POST',
    headers: {'Content-Type':'application/json'},
    body: JSON.stringify({ productId: id })
  }).then(r => r.json()).then(d => { if (d.success) renderCart(d.cart); });
}

function openCart() {
  document.getElementById('cartOverlay').classList.add('open');
  document.getElementById('cartPanel').classList.remove('translate-x-full');
}
function closeCart() {
  document.getElementById('cartOverlay').classList.remove('open');
  document.getElementById('cartPanel').classList.add('translate-x-full');
}

document.addEventListener('DOMContentLoaded', () => filterProducts());
</script>
</body>
</html>
