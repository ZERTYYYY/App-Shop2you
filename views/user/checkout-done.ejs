<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Commande confirmée' }) %>
<body class="min-h-screen flex items-center justify-center p-6">
<div class="text-center max-w-md">
  <div class="w-20 h-20 rounded-full bg-success-light text-success flex items-center justify-center mx-auto mb-6">
    <%- icon('check', 'w-9 h-9') %>
  </div>
  <h1 class="text-3xl mb-3">On s'occupe de tout</h1>
  <p class="text-muted mb-1">Votre commande <strong class="text-accent-dark font-medium"><%= orderId %></strong></p>
  <p class="text-muted mb-8">est confirmée et en cours de préparation !</p>
  <div class="flex gap-3 justify-center flex-wrap">
    <a href="/user/orders" class="btn-outline btn-lg">Mes commandes</a>
    <a href="/user/dashboard" class="btn-accent btn-lg">Continuer</a>
  </div>
</div>
</body>
</html>
