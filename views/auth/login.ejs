<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Shop2You — Connexion</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body>
<div class="auth-page">
  <div class="auth-left">
    <div class="auth-brand">
      <div class="logo">🛍️✈️</div>
      <h1>Shop2You</h1>
      <p>La marketplace qui livre à votre porte ou dans votre Frigo.</p>
      <div style="margin-top:40px; display:flex; gap:32px; justify-content:center;">
        <div style="text-align:center">
          <div style="font-size:2rem; font-weight:800; color:var(--gold)">500+</div>
          <div style="font-size:0.8rem; color:var(--gray)">Vendeurs</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:2rem; font-weight:800; color:var(--gold)">10k</div>
          <div style="font-size:0.8rem; color:var(--gray)">Clients</div>
        </div>
        <div style="text-align:center">
          <div style="font-size:2rem; font-weight:800; color:var(--gold)">99%</div>
          <div style="font-size:0.8rem; color:var(--gray)">Satisfaction</div>
        </div>
      </div>
    </div>
  </div>

  <div class="auth-right">
    <div class="auth-form-wrap">
      <h2>Bon retour ! 👋</h2>
      <p class="subtitle">Connectez-vous à votre compte</p>

      <% if (error) { %>
        <div class="alert alert-error">⚠️ <%= error %></div>
      <% } %>

      <div class="demo-accounts">
        <p>🎯 Comptes démo (cliquez pour remplir)</p>
        <button class="demo-btn" onclick="fillDemo('user@shop2you.com','123456')">👤 Client</button>
        <button class="demo-btn" onclick="fillDemo('livreur@shop2you.com','123456')">🚗 Livreur</button>
        <button class="demo-btn" onclick="fillDemo('vendeur@shop2you.com','123456')">🏪 Vendeur</button>
      </div>

      <form method="POST" action="/login">
        <div class="form-group">
          <label class="form-label">Adresse e-mail</label>
          <input class="form-input" type="email" name="email" id="email" placeholder="exemple@gmail.com" required autocomplete="email">
        </div>
        <div class="form-group">
          <label class="form-label">Mot de passe</label>
          <input class="form-input" type="password" name="password" id="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn btn-gold btn-full btn-lg" style="margin-bottom:16px">Se connecter</button>
      </form>

      <div class="divider"><span>ou continuer avec</span></div>

      <div class="social-btns">
        <button class="social-btn">🔵 Google</button>
        <button class="social-btn">📘 Facebook</button>
        <button class="social-btn">🍎 Apple</button>
      </div>

      <p style="text-align:center; margin-top:24px; font-size:0.9rem; color:var(--gray)">
        Pas encore de compte ? <a href="/signup" style="color:var(--gold-dark); font-weight:600">S'inscrire</a>
      </p>
    </div>
  </div>
</div>

<script>
function fillDemo(email, pass) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = pass;
}
</script>
</body>
</html>
