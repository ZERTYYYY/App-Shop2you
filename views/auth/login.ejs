<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Connexion' }) %>
<body>
<div class="min-h-screen flex">
  <!-- Left: brand -->
  <div class="hidden lg:flex lg:w-5/12 bg-ink/80 backdrop-blur-2xl border-r border-white/10 text-cream flex-col justify-between p-12">
    <div class="flex items-center gap-2.5">
      <img src="/images/logo-icon.png" alt="Shop2You" class="w-9 h-9 object-contain">
      <span class="font-serif text-lg font-semibold">Shop2You</span>
    </div>
    <div>
      <h1 class="text-4xl leading-tight mb-4 text-cream">La marketplace qui&nbsp;livre<br>à votre porte.</h1>
      <p class="text-cream/50 max-w-sm">Achetez, vendez, livrez — une seule plateforme pour les clients, les vendeurs et les livreurs.</p>
      <div class="flex gap-10 mt-10">
        <div>
          <div class="font-serif text-2xl text-accent-light">500+</div>
          <div class="text-xs text-cream/40 mt-1">Vendeurs</div>
        </div>
        <div>
          <div class="font-serif text-2xl text-accent-light">10k</div>
          <div class="text-xs text-cream/40 mt-1">Clients</div>
        </div>
        <div>
          <div class="font-serif text-2xl text-accent-light">99%</div>
          <div class="text-xs text-cream/40 mt-1">Satisfaction</div>
        </div>
      </div>
    </div>
    <p class="text-xs text-cream/30">© 2026 Shop2You — Démo</p>
  </div>

  <!-- Right: form -->
  <div class="flex-1 flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-sm card !p-8">
      <div class="lg:hidden flex items-center gap-2.5 mb-8">
        <div class="w-9 h-9 rounded-full bg-ink flex items-center justify-center p-1.5 shrink-0">
          <img src="/images/logo-icon.png" alt="Shop2You" class="w-full h-full object-contain">
        </div>
        <span class="font-serif text-lg font-semibold">Shop2You</span>
      </div>

      <h2 class="mb-1">Bon retour</h2>
      <p class="text-muted text-sm mb-6">Connectez-vous à votre compte</p>

      <% if (error) { %>
        <div class="mb-5 rounded-xl bg-danger-light/70 backdrop-blur-sm border border-danger/10 text-danger text-sm px-4 py-3"><%= error %></div>
      <% } %>

      <div class="mb-6 rounded-xl border border-white/50 bg-white/20 backdrop-blur-sm p-4">
        <p class="text-xs font-medium uppercase tracking-wide text-muted mb-3">Comptes démo</p>
        <div class="flex flex-wrap gap-2">
          <button type="button" class="badge-neutral hover:border-ink transition-colors" onclick="fillDemo('user@shop2you.com','123456')">Client</button>
          <button type="button" class="badge-neutral hover:border-ink transition-colors" onclick="fillDemo('livreur@shop2you.com','123456')">Livreur</button>
          <button type="button" class="badge-neutral hover:border-ink transition-colors" onclick="fillDemo('vendeur@shop2you.com','123456')">Vendeur</button>
        </div>
      </div>

      <form method="POST" action="/login" class="space-y-4">
        <div>
          <label class="field-label" for="email">Adresse e-mail</label>
          <input class="input" type="email" name="email" id="email" placeholder="exemple@gmail.com" required autocomplete="email">
        </div>
        <div>
          <label class="field-label" for="password">Mot de passe</label>
          <input class="input" type="password" name="password" id="password" placeholder="••••••••" required autocomplete="current-password">
        </div>
        <button type="submit" class="btn-accent btn-full btn-lg !mt-6">Se connecter</button>
      </form>

      <p class="text-center text-sm text-muted mt-6">
        Pas encore de compte ? <a href="/signup" class="text-accent-dark font-medium hover:underline">S'inscrire</a>
      </p>
    </div>
  </div>
</div>

<script>
function fillDemo(email, pass) {
  document.getElementById('email').value = email;
  document.getElementById('password').value = pass;
}
</script>
</body>
</html>
