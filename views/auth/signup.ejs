<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Inscription' }) %>
<body>
<div class="min-h-screen flex">
  <div class="hidden lg:flex lg:w-5/12 bg-ink text-cream flex-col justify-between p-12">
    <div class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-white font-serif font-semibold text-sm">S2</div>
      <span class="font-serif text-lg font-semibold">Shop2You</span>
    </div>
    <div>
      <h1 class="text-4xl leading-tight mb-4 text-cream">Rejoignez la<br>communauté.</h1>
      <p class="text-cream/50 max-w-sm">Que vous achetiez, vendiez ou livriez, votre espace vous attend en une minute.</p>
    </div>
    <p class="text-xs text-cream/30">© 2026 Shop2You — Démo</p>
  </div>

  <div class="flex-1 flex items-center justify-center p-6 sm:p-10">
    <div class="w-full max-w-sm">
      <div class="lg:hidden flex items-center gap-2.5 mb-8">
        <div class="w-9 h-9 rounded-full bg-accent flex items-center justify-center text-white font-serif font-semibold text-sm">S2</div>
        <span class="font-serif text-lg font-semibold">Shop2You</span>
      </div>

      <h2 class="mb-1">Créer un compte</h2>
      <p class="text-muted text-sm mb-6">Rejoignez des milliers d'utilisateurs</p>

      <% if (error) { %>
        <div class="mb-5 rounded-xl bg-danger-light text-danger text-sm px-4 py-3"><%= error %></div>
      <% } %>

      <form method="POST" action="/signup" class="space-y-4">
        <div>
          <label class="field-label" for="name">Nom complet</label>
          <input class="input" type="text" name="name" id="name" placeholder="Jean Dupont" required>
        </div>
        <div>
          <label class="field-label" for="email">Adresse e-mail</label>
          <input class="input" type="email" name="email" id="email" placeholder="exemple@gmail.com" required>
        </div>
        <div>
          <label class="field-label" for="password">Mot de passe</label>
          <input class="input" type="password" name="password" id="password" placeholder="••••••••" required>
        </div>
        <div>
          <label class="field-label" for="role">Vous êtes</label>
          <select class="input" name="role" id="role">
            <option value="user">Client — Je veux acheter</option>
            <option value="delivery">Livreur — Je veux livrer</option>
            <option value="provider">Vendeur — Je veux vendre</option>
          </select>
        </div>
        <button type="submit" class="btn-accent btn-full btn-lg !mt-6">Créer mon compte</button>
      </form>

      <p class="text-center text-sm text-muted mt-6">
        Déjà un compte ? <a href="/login" class="text-accent-dark font-medium hover:underline">Se connecter</a>
      </p>
    </div>
  </div>
</div>
</body>
</html>
