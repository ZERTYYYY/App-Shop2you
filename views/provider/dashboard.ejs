<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Vendeur' }) %>
<body>
<div class="app-shell">
  <% const page = 'dashboard'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Tableau de bord</h1>
        <p class="text-muted text-sm mt-1"><%= user.shopName %></p>
      </div>
      <button class="btn-accent" onclick="alert('Fonctionnalité à venir !')"><%- icon('plus','w-4 h-4') %> Ajouter un produit</button>
    </div>

    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-accent-light text-accent-dark"><%- icon('box','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.products.length %></div><div class="text-xs text-muted">Produits en vente</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-success-light text-success"><%- icon('wallet','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.invoices.filter(i=>i.status==='payée').length %></div><div class="text-xs text-muted">Factures payées</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-warning-light text-warning"><%- icon('trending','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.products.reduce((s,p)=>s+p.sales,0) %></div><div class="text-xs text-muted">Ventes totales</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-danger-light text-danger"><%- icon('card','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.invoices.filter(i=>i.status==='payée').reduce((s,i)=>s+i.amount,0).toFixed(0) %>€</div><div class="text-xs text-muted">Revenus totaux</div></div>
      </div>
    </div>

    <!-- Products table -->
    <div class="card !p-0 overflow-hidden mb-6">
      <div class="flex items-center justify-between px-6 pt-6 pb-4">
        <h3>Mes produits</h3>
        <span class="badge-accent"><%= user.products.length %> produits</span>
      </div>
      <div class="table-wrap">
        <table class="table-base">
          <thead>
            <tr><th class="th-cell">Produit</th><th class="th-cell">Catégorie</th><th class="th-cell">Prix</th><th class="th-cell">Stock</th><th class="th-cell">Ventes</th><th class="th-cell">Action</th></tr>
          </thead>
          <tbody>
            <% user.products.forEach(p => { %>
            <tr>
              <td class="td-cell"><div class="flex items-center gap-3"><div class="w-9 h-9 rounded-lg bg-ink flex items-center justify-center text-cream font-serif text-sm font-semibold shrink-0"><%= p.name.charAt(0).toUpperCase() %></div><span class="font-medium"><%= p.name %></span></div></td>
              <td class="td-cell"><span class="badge-neutral"><%= p.category %></span></td>
              <td class="td-cell font-medium"><%= p.price.toFixed(2) %>€</td>
              <td class="td-cell">
                <% if(p.stock <= 5) { %>
                  <span class="text-danger font-medium inline-flex items-center gap-1"><%= p.stock %> <%- icon('alert', 'w-3.5 h-3.5') %></span>
                <% } else { %>
                  <span><%= p.stock %></span>
                <% } %>
              </td>
              <td class="td-cell"><span class="badge-success">+<%= p.sales %></span></td>
              <td class="td-cell">
                <button class="btn-outline btn-sm" onclick="alert('Modification à venir !')"><%- icon('pencil','w-3.5 h-3.5') %></button>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Recent invoices -->
    <div class="card !p-0 overflow-hidden">
      <div class="flex items-center justify-between px-6 pt-6 pb-4">
        <h3>Dernières factures</h3>
        <a href="/provider/invoices" class="text-accent-dark text-sm font-medium hover:underline">Voir tout →</a>
      </div>
      <div class="table-wrap">
        <table class="table-base">
          <thead>
            <tr><th class="th-cell">N° Facture</th><th class="th-cell">Client</th><th class="th-cell">Date</th><th class="th-cell">Montant</th><th class="th-cell">Statut</th></tr>
          </thead>
          <tbody>
            <% user.invoices.slice(0,3).forEach(inv => { %>
            <tr>
              <td class="td-cell font-medium"><%= inv.id %></td>
              <td class="td-cell"><%= inv.client %></td>
              <td class="td-cell text-muted"><%= inv.date %></td>
              <td class="td-cell font-medium"><%= inv.amount.toFixed(2) %>€</td>
              <td class="td-cell">
                <% if(inv.status === 'payée') { %>
                  <span class="badge-success"><%- icon('check','w-3.5 h-3.5') %> Payée</span>
                <% } else { %>
                  <span class="badge-warning"><%- icon('clock','w-3.5 h-3.5') %> En attente</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
