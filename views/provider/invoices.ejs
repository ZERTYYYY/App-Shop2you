<!DOCTYPE html>
<html lang="fr">
<%- include('../partials/head', { title: 'Factures' }) %>
<body>
<div class="app-shell">
  <% const page = 'invoices'; %>
  <%- include('../partials/sidebar', {user, page}) %>
  <main class="main-content">
    <div class="flex items-start justify-between gap-4 mb-8 flex-wrap">
      <div>
        <h1>Factures</h1>
        <p class="text-muted text-sm mt-1">Toutes vos transactions</p>
      </div>
      <button class="btn-accent" onclick="alert('Export PDF à venir !')"><%- icon('download','w-4 h-4') %> Exporter</button>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-success-light text-success"><%- icon('wallet','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.invoices.filter(i=>i.status==='payée').reduce((s,i)=>s+i.amount,0).toFixed(2) %>€</div><div class="text-xs text-muted">Total encaissé</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-warning-light text-warning"><%- icon('clock','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.invoices.filter(i=>i.status==='en attente').reduce((s,i)=>s+i.amount,0).toFixed(2) %>€</div><div class="text-xs text-muted">En attente</div></div>
      </div>
      <div class="card card-hover group !p-5 flex items-center gap-3.5">
        <div class="stat-icon bg-accent-light text-accent-dark"><%- icon('file','w-5 h-5') %></div>
        <div><div class="text-xl font-semibold"><%= user.invoices.length %></div><div class="text-xs text-muted">Total factures</div></div>
      </div>
    </div>

    <div class="card !p-0 overflow-hidden">
      <div class="table-wrap">
        <table class="table-base">
          <thead>
            <tr><th class="th-cell">N° Facture</th><th class="th-cell">Client</th><th class="th-cell">Date</th><th class="th-cell">Montant</th><th class="th-cell">Statut</th><th class="th-cell">Action</th></tr>
          </thead>
          <tbody>
            <% user.invoices.forEach(inv => { %>
            <tr>
              <td class="td-cell font-medium"><%= inv.id %></td>
              <td class="td-cell"><%= inv.client %></td>
              <td class="td-cell text-muted"><%= inv.date %></td>
              <td class="td-cell font-medium"><%= inv.amount.toFixed(2) %>€</td>
              <td class="td-cell">
                <% if(inv.status === 'payée') { %>
                  <span class="badge-success"><%- icon('check','w-3.5 h-3.5') %> Payée</span>
                <% } else { %>
                  <span class="badge-warning"><%- icon('clock','w-3.5 h-3.5') %> En attente</span>
                <% } %>
              </td>
              <td class="td-cell"><button class="btn-outline btn-sm" onclick="alert('Téléchargement à venir !')"><%- icon('download','w-3.5 h-3.5') %> PDF</button></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</div>
</body>
</html>
