<!DOCTYPE html>
<html lang="fr">
<%- include('partials/head', { title: 'Paramètres' }) %>
<body>
<div class="app-shell">
  <%- include('partials/sidebar', {user, page: 'settings'}) %>
  <main class="main-content">
    <div class="mb-8">
      <h1>Paramètres</h1>
      <p class="text-muted text-sm mt-1">Gérez vos préférences</p>
    </div>

    <div class="card mb-6">
      <h3 class="mb-4">Notifications</h3>
      <div class="divide-y divide-border">
        <label class="flex justify-between items-center py-3 cursor-pointer">
          <span class="text-sm">Notifications par e-mail</span>
          <input type="checkbox" checked class="w-4 h-4 accent-accent">
        </label>
        <label class="flex justify-between items-center py-3 cursor-pointer">
          <span class="text-sm">Notifications push</span>
          <input type="checkbox" checked class="w-4 h-4 accent-accent">
        </label>
        <label class="flex justify-between items-center py-3 cursor-pointer">
          <span class="text-sm">Offres promotionnelles</span>
          <input type="checkbox" class="w-4 h-4 accent-accent">
        </label>
      </div>
    </div>

    <div class="card">
      <h3 class="mb-4">Préférences</h3>
      <div class="divide-y divide-border text-sm">
        <div class="flex justify-between py-2.5"><span class="text-muted">Langue</span><span class="font-medium">Français</span></div>
        <div class="flex justify-between py-2.5"><span class="text-muted">Devise</span><span class="font-medium">EUR (€)</span></div>
        <div class="flex justify-between py-2.5"><span class="text-muted">Thème</span><span class="font-medium">Clair</span></div>
      </div>
    </div>
  </main>
</div>
</body>
</html>
