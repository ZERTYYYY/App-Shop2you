{
  "name": "shop2you",
  "version": "1.0.0",
  "description": "Shop2You - Marketplace & Delivery App",
  "main": "server.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prestart": "npm run build:css",
    "start": "node server.js",
    "predev": "npm run build:css",
    "dev": "nodemon server.js",
    "build:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/style.css --minify",
    "watch:css": "tailwindcss -i ./src/tailwind.css -o ./public/css/style.css --watch"
  },
  "dependencies": {
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-session": "^1.17.3"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.19"
  }
}
